# ── Deployer ──────────────────────────────────────────────────────────────────
# Clave privada de la wallet desplegadora (NO commitear el .env real)
DEPLOYER_PRIVATE_KEY=0x...

# ── RPCs ──────────────────────────────────────────────────────────────────────
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
POLYGON_MAINNET_RPC=https://polygon-rpc.com

# ── Verificación en Polygonscan ────────────────────────────────────────────────
POLYGONSCAN_API_KEY=

# ── Parámetros de despliegue ───────────────────────────────────────────────────
# Dirección admin (multisig recomendado en producción)
ADMIN_ADDRESS=

# Dirección del motor de gobernanza (servicio Fastify) — VotingRegistry
GOVERNANCE_ENGINE_ADDRESS=

# Dirección del servicio de identidad — CivicSBT minter
MINTER_ADDRESS=

# ── Gas reporter ──────────────────────────────────────────────────────────────
REPORT_GAS=false
