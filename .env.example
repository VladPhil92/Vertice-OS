# ═══════════════════════════════════════════════════════════════════
# VÉRTICE OS — Variables de Entorno
# Copiar como .env y completar con valores reales
# NUNCA commitear .env al repositorio
# ═══════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ── Credenciales de Bases de Datos ────────────────────────────────
# Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=[generar-con-openssl-rand-hex-24]
REDIS_PASSWORD=[generar-con-openssl-rand-hex-24]
NEO4J_PASSWORD=[generar-con-openssl-rand-hex-24]

# ── Base de Datos Principal (PostgreSQL + PostGIS) ─────────────────
DATABASE_URL=postgresql://vertice:[POSTGRES_PASSWORD]@localhost:5432/vertice_os

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Neo4j (Grafo de reputación) ────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=[generar-con-openssl-rand-hex-24]
NEO4J_DATABASE=neo4j

# ── Auth / JWT ─────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32  (mínimo 32 chars)
JWT_SECRET=[generar-con-openssl-rand-hex-32]
JWT_ACCESS_EXPIRY_SECONDS=900         # 15 minutos
JWT_REFRESH_EXPIRY_SECONDS=604800     # 7 días
BCRYPT_ROUNDS=12

# Claves separadas de JWT_SECRET a propósito — cada una es su propio dominio
# criptográfico. Reutilizar JWT_SECRET aquí (el fallback que usa el código en
# desarrollo si faltan) colapsaría sesiones, nulificadores de voto y
# protección de cédulas en un único secreto. OBLIGATORIAS en producción.
# Generar cada una con: openssl rand -hex 32
VOTE_NULLIFIER_SECRET=[generar-con-openssl-rand-hex-32]
IDENTITY_PEPPER=[generar-con-openssl-rand-hex-32]

# ── CTG One federation ─────────────────────────────────────────────
# Intercambio server-to-server de códigos PKCE de un solo uso. El mismo secreto
# debe configurarse como VERTICE_FEDERATION_SECRET en CTG One. No exponerlo al
# frontend ni colocarlo en URLs, logs o variables NEXT_PUBLIC_*.
CTG_ONE_FEDERATION_EXCHANGE_URL=https://ctgone.com/api/federation/vertice/exchange
CTG_ONE_FEDERATION_SECRET=[generar-con-openssl-rand-hex-32]

# ── Civic Identity Assurance / Proofing ───────────────────────────
# Lista explícita, separada por comas, de proveedores cuyo proofing real VÉRTICE
# acepta para acciones de gobernanza de alto impacto. Vacío = fail-closed.
# `ctg_one` es federación/SSO y NO debe añadirse por defecto.
# Para adapters nativos P0.7+, además de estar compilados, sus credenciales
# feature-scoped deben estar completas. Configurar credenciales SIN añadir el
# provider a esta allowlist permite ejecutar un canary sin habilitar gobernanza.
CIVIC_IDENTITY_ASSURANCE_PROVIDERS=

# P0.9 — promoción explícita después del canary externo. Para providers nativos
# como Veriff, credenciales + allowlist NO habilitan gobernanza hasta que el
# provider aparezca también aquí. Mantener vacío durante sandbox/certificación.
# Ejemplo únicamente DESPUÉS de aprobar la evidencia externa: veriff
CIVIC_IDENTITY_CERTIFIED_PROVIDERS=

# Registro legacy/interno provider -> key-id -> secreto HMAC para el salto
# adapter→VÉRTICE de `/identity/proofing/events`. Los webhooks nativos directos
# P0.7+ (como Veriff) NO necesitan este keyset para quedar runtime-ready.
# Generar cada secreto con `openssl rand -hex 32`; nunca usar NEXT_PUBLIC_*.
CIVIC_IDENTITY_PROOFING_ADAPTER_KEYS_JSON={}

# Variable legacy P0.2: el runtime P0.4 ya no autentica ingress con un secreto
# global. Se conserva temporalmente solo para migraciones antiguas.
# CIVIC_IDENTITY_PROOFING_EVENT_SECRET=

# ── Veriff — Colombia Identity Provider P0.8/P0.9 ──────────────────
# Obtener estos tres valores en Veriff Customer Portal > Integration > API Keys.
# El Base URL es específico de la integración: NO asumir un hostname genérico.
# Sin los tres valores, Veriff permanece fail-closed y la API sigue arrancando.
# VERIFF_BASE_URL=https://<base-url-asignado-por-veriff>
# VERIFF_API_KEY=<api-key>
# VERIFF_SHARED_SECRET=<shared-secret-key>

# Redirect del usuario después del flujo alojado de Veriff. Si se omite,
# VÉRTICE deriva /dashboard/identity desde CORS_ORIGIN.
# VERIFF_CALLBACK_URL=https://vertice.ctgone.com/dashboard/identity

# Código de status personalizado en Veriff Customer Portal utilizado para
# propagar una revocación administrativa autenticada. Debe coincidir exactamente.
VERIFF_REVOCATION_STATUS_CODE=vertice_revoked

# Webhooks a configurar en Veriff una vez existan credenciales sandbox:
# Decision webhook: https://<API_PUBLICA>/identity/providers/veriff/webhook
# User-defined statuses webhook: misma URL (el adapter distingue el payload firmado)

# ── Email (SMTP — SendGrid, AWS SES, Brevo, etc.) ─────────────────
# Dejar SMTP_HOST vacío en dev — los emails se imprimen en consola
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=[tu-sendgrid-api-key]
EMAIL_FROM=noreply@vertice.ctgone.com
NEXT_PUBLIC_WEB_URL=https://vertice.ctgone.com

# ── Servicio IA (apps/ai — FastAPI en puerto 8001) ─────────────────
AI_SERVICE_URL=http://localhost:8001
# OBLIGATORIO en producción: autentica las llamadas internas de la API al
# servicio de IA. Sin él, tanto la API como el servicio se niegan a arrancar
# (NODE_ENV=production) y los endpoints internos rechazan toda petición.
AI_SERVICE_SECRET=[generar-con-openssl-rand-hex-24]

# ── CORS ────────────────────────────────────────────────────────────
# Producción: https://vertice.ctgone.com
CORS_ORIGIN=http://localhost:3000

# ── Vector DB (Pinecone) ───────────────────────────────────────────
PINECONE_API_KEY=...
PINECONE_INDEX=vertice-rag
PINECONE_ENVIRONMENT=us-east-1

# ── Embeddings (Voyage AI — recomendado por Anthropic para RAG) ────
VOYAGE_API_KEY=pa-...   # https://dash.voyageai.com/api-keys

# ── Blockchain ─────────────────────────────────────────────────────
# Si estas variables no están definidas, el minting se omite silenciosamente.
# Para Amoy testnet: POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_PRIVATE_KEY=0x...           # Clave privada del minter — NUNCA en frontend
CIVIC_SBT_ADDRESS=0x...             # Dirección del contrato CivicSBT desplegado en Polygon
VOTING_REGISTRY_ADDRESS=0x...       # Dirección del contrato VotingRegistry desplegado en Polygon
IPFS_GATEWAY=https://ipfs.io/ipfs
# Secreto (mín. 32 chars) para derivar el compromiso del DID que va on-chain.
# El contrato nunca almacena el DID en claro; guarda keccak256(pepper:did).
# OBLIGATORIO si CIVIC_SBT_ADDRESS está configurado.
# PERMANENTE: rotarlo rompe el vínculo con los badges ya emitidos.
DID_COMMITMENT_PEPPER=[generar-con-openssl-rand-hex-32]

# ── Frontend (Next.js — prefijo NEXT_PUBLIC_ = expuesto al cliente)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.ey...
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_POLYGON_RPC=https://polygon-rpc.com
NEXT_PUBLIC_ENVIRONMENT=development

# ── Servicios externos ─────────────────────────────────────────────
REGISTRADURIA_API_URL=https://api.registraduria.gov.co  # Si existe
MAPBOX_SECRET_TOKEN=sk.ey...
SENDGRID_API_KEY=SG...        # Email transaccional
TWILIO_SID=AC...              # SMS OTP
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE=+1...

# ── Monitoreo ──────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
PROMETHEUS_PORT=9090
LOG_LEVEL=info

# ── Cloudflare ─────────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=...
CLOUDFLARE_API_TOKEN=...
