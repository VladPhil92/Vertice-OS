# ═══════════════════════════════════════════════════════════════════
# VÉRTICE OS — Variables de Entorno
# Copiar como .env y completar con valores reales
# NUNCA commitear .env al repositorio
# ═══════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=vertice-os
APP_VERSION=0.1.0

# ── Credenciales de Bases de Datos ────────────────────────────────
# Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=[generar-con-openssl-rand-hex-24]
MONGO_ROOT_PASSWORD=[generar-con-openssl-rand-hex-24]
REDIS_PASSWORD=[generar-con-openssl-rand-hex-24]
NEO4J_PASSWORD=[generar-con-openssl-rand-hex-24]

# ── Base de Datos Principal ────────────────────────────────────────
DATABASE_URL=postgresql://vertice:${POSTGRES_PASSWORD}@localhost:5432/vertice_os?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── MongoDB ────────────────────────────────────────────────────────
MONGODB_URI=mongodb://vertice:${MONGO_ROOT_PASSWORD}@localhost:27017/vertice_os
MONGODB_DB=vertice_os

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379
REDIS_SESSION_TTL=604800  # 7 días en segundos

# ── Neo4j (Graph DB) ───────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=${NEO4J_PASSWORD}

# ── IA ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=1024

# ── Vector DB (Pinecone) ───────────────────────────────────────────
PINECONE_API_KEY=...
PINECONE_INDEX=vertice-rag
PINECONE_ENVIRONMENT=us-east-1

# ── Blockchain ─────────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_PRIVATE_KEY=0x...  # Solo para el backend, nunca en frontend
EAS_CONTRACT_ADDRESS=0xC2679fBD37d54388Ce493F1DB75320D236e1815e
IPFS_GATEWAY=https://gateway.pinata.cloud

# ── Frontend (Next.js — prefijo NEXT_PUBLIC_ = expuesto al cliente)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.ey...
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_POLYGON_RPC=https://polygon-rpc.com
NEXT_PUBLIC_ENVIRONMENT=development

# ── Auth / JWT ─────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=[generar-con-openssl-rand-hex-32]
JWT_ACCESS_EXPIRY=900         # 15 minutos
JWT_REFRESH_EXPIRY=604800     # 7 días

# ── Servicios externos ─────────────────────────────────────────────
REGISTRADURIA_API_URL=https://api.registraduria.gov.co  # Si existe
MAPBOX_SECRET_TOKEN=sk.ey...
SENDGRID_API_KEY=SG...        # Email transaccional
TWILIO_SID=AC...              # SMS OTP
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE=+1...

# ── Monitoreo ──────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
PROMETHEUS_PORT=9090
LOG_LEVEL=info

# ── Cloudflare ─────────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=...
CLOUDFLARE_API_TOKEN=...
