{
  "name": "@vertice/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --coverage --coverageReporters=lcov --coverageThreshold='{\"global\":{\"branches\":60,\"functions\":65,\"lines\":70,\"statements\":70}}'",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@vertice/types": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@prisma/client": "^5.14.0",
    "@sentry/node": "^10.53.1",
    "@types/nodemailer": "^8.0.0",
    "bcrypt": "^5.1.1",
    "ethers": "^6.16.0",
    "fastify": "^5.11.2",
    "ioredis": "^5.3.2",
    "neo4j-driver": "^6.0.1",
    "nodemailer": "^9.0.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/uuid": "^10.0.0",
    "jest": "^30.0.0",
    "prisma": "^5.14.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.15.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "setupFiles": [
      "./src/__tests__/setup.ts"
    ]
  }
}
