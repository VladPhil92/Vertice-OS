generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Citizen {
  id                String    @id @default(uuid()) @db.Uuid
  did               String    @unique
  cedulaHash        String    @unique @map("cedula_hash")
  email             String?   @unique
  passwordHash      String?   @map("password_hash")
  localityId        Int?      @map("locality_id")
  neighborhood      String?
  verificationLevel Int       @default(0) @map("verification_level") @db.SmallInt
  reputationScore   Decimal   @default(0) @map("reputation_score") @db.Decimal(10, 4)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActiveAt      DateTime? @map("last_active_at") @db.Timestamptz(6)

  sessions Session[]

  @@map("citizens")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  citizenId        String    @map("citizen_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")

  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([citizenId], map: "idx_sessions_citizen_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model localities {
  id                  Int       @id @default(autoincrement())
  name                String
  code                String    @unique
  population_estimate Int?
  area_km2            Decimal?  @db.Decimal(8, 2)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model proposals {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id              String?   @db.Uuid
  title                  String
  description            String
  executive_summary      String?
  category               String
  scope                  String
  status                 String?   @default("idea")
  endorsement_count      Int?      @default(0)
  comment_count          Int?      @default(0)
  view_count             Int?      @default(0)
  quorum_required        Decimal?  @db.Decimal(4, 3)
  approval_threshold     Decimal?  @db.Decimal(4, 3)
  eligible_voters        Int?
  total_votes            Int?      @default(0)
  approve_votes_weighted Decimal?  @default(0) @db.Decimal(12, 4)
  reject_votes_weighted  Decimal?  @default(0) @db.Decimal(12, 4)
  abstain_votes_weighted Decimal?  @default(0) @db.Decimal(12, 4)
  assigned_executor      String?
  execution_deadline     DateTime? @db.Date
  blockchain_tx_hash     String?
  ipfs_proposal_uri      String?
  ipfs_result_uri        String?
  created_at             DateTime? @default(now()) @db.Timestamptz(6)
  draft_started_at       DateTime? @db.Timestamptz(6)
  debate_started_at      DateTime? @db.Timestamptz(6)
  voting_starts_at       DateTime? @db.Timestamptz(6)
  voting_ends_at         DateTime? @db.Timestamptz(6)
  decided_at             DateTime? @db.Timestamptz(6)

  @@index([author_id], map: "idx_proposals_author")
  @@index([category, scope], map: "idx_proposals_category")
  @@index([status, created_at(sort: Desc)], map: "idx_proposals_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model territorial_reports {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  citizen_id        String?                  @db.Uuid
  category          String
  subcategory       String?
  title             String
  description       String
  location          Unsupported("geography")
  neighborhood      String?
  locality_id       Int?
  address_reference String?
  urgency_score     Decimal?                 @db.Decimal(4, 3)
  sentiment_score   Decimal?                 @db.Decimal(4, 3)
  cluster_id        String?
  status            String?                  @default("open")
  assigned_to       String?
  media_urls        String[]
  ipfs_hash         String?
  created_at        DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?                @default(now()) @db.Timestamptz(6)
  resolved_at       DateTime?                @db.Timestamptz(6)

  @@index([category, status], map: "idx_reports_category")
  @@index([citizen_id], map: "idx_reports_citizen_id")
  @@index([locality_id, status], map: "idx_reports_locality")
  @@index([location], map: "idx_reports_location", type: Gist)
  @@index([status, created_at(sort: Desc)], map: "idx_reports_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model votes {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposal_id      String    @db.Uuid
  nullifier_hash   String    @unique
  vote_weight      Decimal   @db.Decimal(6, 4)
  vote_value       Int       @db.SmallInt
  is_delegated     Boolean?  @default(false)
  delegation_depth Int?      @default(0) @db.SmallInt
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@index([proposal_id, vote_value, vote_weight], map: "idx_votes_tally")
}
