{
  "expo": {
    "name": "Vértice OS",
    "slug": "vertice-os",
    "scheme": "vertice",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ctgone.verticeos"
    },
    "android": {
      "package": "com.ctgone.verticeos"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
