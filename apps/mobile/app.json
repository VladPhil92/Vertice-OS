{
  "expo": {
    "name": "Vértice OS",
    "slug": "vertice-os",
    "owner": "ctg-one-technology",
    "scheme": "vertice",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icons/icon.png",
    "backgroundColor": "#F7F9FC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ctgone.verticeos"
    },
    "android": {
      "package": "com.ctgone.verticeos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon-foreground.png",
        "backgroundColor": "#F7F9FC"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F7F9FC"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vértice usa tu ubicación mientras reportas para asociar el incidente al lugar correcto."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vértice accede a tus fotos solo cuando eliges evidencia para un reporte ciudadano.",
          "cameraPermission": "Vértice usa la cámara solo cuando decides capturar evidencia para un reporte ciudadano.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "civic-updates",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
