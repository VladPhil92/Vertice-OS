# Public API origin used by the native app. Never place secrets in EXPO_PUBLIC_* variables.
# Local iOS simulator: http://localhost:4000
# Local Android emulator: http://10.0.2.2:4000
# Physical device: use the HTTPS/LAN-reachable API origin.
EXPO_PUBLIC_API_URL=https://api.example.com

# Build-time native provider identifiers. Configure these in EAS/environment
# rather than hardcoding production values in app.json.
# EAS_PROJECT_ID is required to obtain Expo push tokens on physical devices.
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Android Google Maps SDK key. Restrict the production key to package
# com.ctgone.verticeos + the signing certificate fingerprint in Google Cloud.
GOOGLE_MAPS_API_KEY=replace-with-restricted-android-key
