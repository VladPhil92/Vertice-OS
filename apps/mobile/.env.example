# Public API origin used by the native app. Never place secrets in EXPO_PUBLIC_* variables.
# Local iOS simulator: http://localhost:4000
# Local Android emulator: http://10.0.2.2:4000
# Preview/production builds are fail-closed and require an HTTPS non-local origin.
EXPO_PUBLIC_API_URL=https://api.example.com

# Build-time variant. EAS profiles set this automatically; local release validation may set it explicitly.
# Allowed operational values: development, preview, production.
APP_VARIANT=development

# Expo/EAS project UUID from the real linked project. Required by preview/production config
# and used to attribute Expo push tokens to the correct project.
# Configure the real value in the corresponding EAS environment; do not commit it here.
EAS_PROJECT_ID=11111111-1111-4111-8111-111111111111

# Android Maps SDK key for com.ctgone.verticeos. Preview/production builds require it.
# Restrict the real key in Google Cloud by Android application id + signing SHA-1 certificate.
GOOGLE_MAPS_ANDROID_API_KEY=replace-with-restricted-build-secret

# Non-secret release channel used for diagnostics/build metadata.
# EAS profiles set this to development/preview/production.
EXPO_PUBLIC_RELEASE_CHANNEL=development
