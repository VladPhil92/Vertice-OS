{
  "name": "vertice-os",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema Operativo Cívico — Cartagena de Indias, Colombia",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "@eslint/eslintrc": "^3.0.0",
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react-hooks": "^5.1.0",
      "@next/eslint-plugin-next": "^15.0.0",
      "@typescript-eslint/parser": "^8.0.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "bcrypt",
      "esbuild",
      "keccak",
      "prisma",
      "secp256k1",
      "unrs-resolver"
    ]
  },
  "keywords": [
    "civic-tech",
    "democracy",
    "governance",
    "colombia",
    "cartagena",
    "ai",
    "blockchain",
    "participation"
  ],
  "packageManager": "pnpm@10.34.5",
  "author": "CTG One Corporation",
  "license": "UNLICENSED"
}
